# Binary Altium containers must never be line-ending-normalized.
*.SchLib -text
*.PcbLib -text
*.IntLib -text

# LibPkg is an INI-like project file and remains reviewable in Git.
*.LibPkg text eol=crlf

# Repository-owned text files use LF on every platform.
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
